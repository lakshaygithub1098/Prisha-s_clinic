# Local test environment only. Keep the real .env file private and uncommitted.
NODE_ENV=development
APP_ENV=development
PORT=5000
HOST=127.0.0.1

# Add the Atlas URI locally. It is overridden to use this isolated database name.
MONGODB_URI=
MONGODB_DATABASE=prisha_clinic_test

# Optional: choose/reset the shared synthetic doctor/admin seed password.
# TEST_ACCOUNT_PASSWORD=

# Exact local web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# For each deployed Next.js app, set BACKEND_API_URL to the API origin.
# The apps proxy /api/v1 through their own domain so session cookies stay first-party.
